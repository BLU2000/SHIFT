p-tip{align-self:flex-start;border-bottom:none;border-left:none;border-top-color:#fff}.maplibregl-popup-anchor-bottom-right .maplibregl-popup-tip{align-self:flex-end;border-bottom:none;border-right:none;border-top-color:#fff}.maplibregl-popup-anchor-left .maplibregl-popup-tip{align-self:center;border-left:none;border-right-color:#fff}.maplibregl-popup-anchor-right .maplibregl-popup-tip{align-self:center;border-left-color:#fff;border-right:none}.maplibregl-popup-close-button{background-color:transparent;border:0;border-radius:0 3px 0 0;cursor:pointer;position:absolute;right:0;top:0}.maplibregl-popup-close-button:hover{background-color:rgb(0 0 0/5%)}.maplibregl-popup-content{background:#fff;border-radius:3px;box-shadow:0 1px 2px rgba(0,0,0,.1);padding:15px 10px;pointer-events:auto;position:relative}.maplibregl-popup-anchor-top-left .maplibregl-popup-content{border-top-left-radius:0}.maplibregl-popup-anchor-top-right .maplibregl-popup-content{border-top-right-radius:0}.maplibregl-popup-anchor-bottom-left .maplibregl-popup-content{border-bottom-left-radius:0}.maplibregl-popup-anchor-bottom-right .maplibregl-popup-content{border-bottom-right-radius:0}.maplibregl-popup-track-pointer{display:none}.maplibregl-popup-track-pointer *{pointer-events:none;-webkit-user-select:none;-moz-user-select:none;user-select:none}.maplibregl-map:hover .maplibregl-popup-track-pointer{display:flex}.maplibregl-map:active .maplibregl-popup-track-pointer{display:none}.maplibregl-marker{left:0;position:absolute;top:0;transition:opacity .2s;will-change:transform}.maplibregl-user-location-dot,.maplibregl-user-location-dot:before{background-color:#1da1f2;border-radius:50%;height:15px;width:15px}.maplibregl-user-location-dot:before{animation:maplibregl-user-location-dot-pulse 2s infinite;content:"";position:absolute}.maplibregl-user-location-dot:after{border:2px solid #fff;border-radius:50%;box-shadow:0 0 3px rgba(0,0,0,.35);box-sizing:border-box;content:"";height:19px;left:-2px;position:absolute;top:-2px;width:19px}@keyframes maplibregl-user-location-dot-pulse{0%{opacity:1;transform:scale(1)}70%{opacity:0;transform:scale(3)}to{opacity:0;transform:scale(1)}}.maplibregl-user-location-dot-stale{background-color:#aaa}.maplibregl-user-location-dot-stale:after{display:none}.maplibregl-user-location-accuracy-circle{background-color:#1da1f233;border-radius:100%;height:1px;width:1px}.maplibregl-crosshair,.maplibregl-crosshair .maplibregl-interactive,.maplibregl-crosshair .maplibregl-interactive:active{cursor:crosshair}.maplibregl-boxzoom{background:#fff;border:2px dotted #202020;height:0;left:0;opacity:.5;position:absolute;top:0;width:0}.maplibregl-cooperative-gesture-screen{align-items:center;background:rgba(0,0,0,.4);color:#fff;display:flex;font-size:1.4em;inset:0;justify-content:center;line-height:1.2;opacity:0;padding:1rem;pointer-events:none;position:absolute;transition:opacity 1s ease 1s;z-index:99999}.maplibregl-cooperative-gesture-screen.maplibregl-show{opacity:1;transition:opacity .05s}.maplibregl-cooperative-gesture-screen .maplibregl-mobile-message{display:none}@media (hover:none),(pointer:coarse){.maplibregl-cooperative-gesture-screen .maplibregl-desktop-message{display:none}.maplibregl-cooperative-gesture-screen .maplibregl-mobile-message{display:block}}.maplibregl-pseudo-fullscreen{height:100%!important;left:0!important;position:fixed!important;top:0!important;width:100%!important;z-index:99999}</style>
<style>.location-picker{margin:22px 0;padding:16px 0;background:white;border-top:1px solid var(--line);border-bottom:1px solid var(--line);border-radius:0}
.map-heading{display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap;font-size:12px}
.map-heading a{font-size:11px;color:var(--green)}
.location-map{width:100%;height:350px;margin-top:12px;border:1px solid #00000026;border-radius:0;background:white}
.location-map[hidden]{display:none}
.map-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}
.map-actions button{font-size:11px;padding:7px 10px}
.location-map .maplibregl-ctrl-attrib{font:10px/1.4 "DIN 2014",Bahnschrift,Arial,sans-serif;max-width:100%;white-space:normal}
.location-map .maplibregl-ctrl button{padding:0;border-radius:0}
.location-map canvas:focus-visible{outline:3px solid #002FA7;outline-offset:-3px}
@media(max-width:650px){.location-map{height:300px}}
.overview-map-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:12px 0;font-size:11px}.overview-map-toolbar button{padding:6px 9px;font-size:11px}.geographic-map{height:420px;width:100%;background:white;border:1px solid #00000026}.geographic-map .maplibregl-ctrl button{padding:0}.geographic-map .maplibregl-ctrl-attrib{font:10px/1.4 "DIN 2014",Bahnschrift,Arial,sans-serif}.overview-marker{border:2px solid white;border-radius:50%;width:18px;height:18px;min-width:18px;padding:0;background:#002FA7;color:white;box-shadow:0 1px 4px #00000055;font-size:10px;line-height:14px}.overview-marker:not(:empty){width:26px;height:26px;line-height:22px}.overview-marker:hover,.overview-marker:focus-visible{background:black}.overview-popup{font-family:"DIN 2014",Bahnschrift,Arial,sans-serif;max-height:260px;overflow:auto}.overview-photo{display:flex;align-items:center;gap:9px;width:100%;margin-top:8px;padding:6px;text-align:left;font-size:11px}.overview-photo img{width:45px;height:55px;object-fit:cover}.geographic-map .maplibregl-popup-close-button{padding:1px 6px;border:0}#overviewMapFallback summary{font-size:11px;cursor:pointer}@media(max-width:650px){.geographic-map{height:340px}}
</style>
<style id="facade-design">
header{min-height:70px;padding:16px 28px;background:white}.logo{font-size:25px;font-weight:600;letter-spacing:-.8px}.logo-period{color:#002FA7}.header-caption{font-size:11px;color:#00000080}.revision-label{font-size:11px;letter-spacing:.07em;color:#002FA7;white-space:nowrap}.toolbar{gap:20px}.toolbar .primary{min-width:86px}.save-state{min-width:0;font-size:10px}button,input,select,textarea{border-radius:0}button{padding:9px 15px}aside{padding:26px 18px}.photo-item{border-radius:0}.photo-item.active{border-color:transparent;border-left:2px solid #002FA7;background:#002FA709;box-shadow:none}.photo-item img{border-radius:0}.status-dot{border-radius:50%}.workbench{gap:32px}.form-panel{border:0;border-left:1px solid #00000026;border-radius:0;padding:0 0 0 28px}.photo-frame{border-radius:0}.photo-caption{font-size:10px}.notice{background:none;border-left:2px solid #002FA7;border-radius:0;padding:4px 12px;font-size:11px}.option{border-radius:0;padding:9px 12px}.option:has(input:checked){background:#002FA7;color:white}.section-number{background:none;color:#002FA7;padding:0;border-radius:0}.step{border-radius:0;border-bottom:2px solid transparent}.step.active{background:none;border-bottom-color:#002FA7;color:#002FA7}.steps{gap:12px;padding-bottom:0}.step{padding:10px 0;margin-right:12px}.field{margin:24px 0}.field legend,.field>label{font-size:12px;font-weight:500}h1{font-weight:500}h2{font-size:23px;font-weight:500;margin:12px 0}.form-footer{margin-top:28px}.stat,.insight-card{border-radius:0}.type-tabs .active{background:#002FA7;color:white}.merge-link{margin-top:18px;padding:4px 0;border:0;border-bottom:1px solid #00000040;background:none;font-size:11px}.save-dialog{border:0;border-radius:0;padding:30px;max-width:440px}.save-dialog label{display:block;font-size:12px;margin:22px 0 8px}.save-dialog input{width:100%;text-transform:uppercase;font-size:22px;padding:12px}.save-dialog h2{margin-top:12px}.filename-preview{padding:16px 0;margin:22px 0;border-top:1px solid #00000026;border-bottom:1px solid #00000026}.filename-preview output{display:block;color:#002FA7;margin-top:6px;overflow-wrap:anywhere}.save-dialog .form-footer{border:0;padding:0}.app-footer{letter-spacing:.04em}@media(max-width:1050px){.form-panel{border-left:0;border-top:1px solid #00000026;padding:24px 0 0}}@media(max-width:650px){.header-caption{display:none}.toolbar{margin-left:auto;gap:12px}.save-state{display:none}.steps{gap:5px}.step{font-size:10px}.save-dialog{padding:22px}}
</style>
<style id="blue-background">
:root{--bg:#002FA7}body,main{background:#002FA7}.intro h1,.intro .eyebrow,.intro .muted{color:white}.steps{border-bottom-color:#ffffff55}.step,.step.active{color:white}.step.active{border-bottom-color:white}.step:hover{background:#ffffff18}.step:focus-visible{outline-color:white}.form-panel{padding:24px;background:white;border:0}.photo-caption,.photo-caption a{color:white}.photo-panel>.notice{color:white;border-left-color:white}footer.app-footer{color:#ffffffcc}.intro>button{background:white;color:#002FA7}@media(max-width:650px){.form-panel{padding:18px}}
</style>
<style>.analysis-wide{grid-column:1/-1}.radar-dimensions{border:0;padding:0;margin:22px 0;display:flex;flex-wrap:wrap;gap:10px 22px}.radar-dimensions legend{font-size:12px;margin-bottom:10px}.radar-dimensions label{font-size:12px;display:flex;gap:7px;align-items:center}.radar-dimensions input{margin:0;accent-color:#002FA7}.chart-selectors{display:grid;grid-template-columns:1fr 1fr;gap:16px}.chart-selectors>label{font-size:11px}.chart-selectors select{display:block;width:100%;max-width:100%;margin:6px 0 12px;font-size:12px}#radar svg{display:block;max-width:650px;margin:auto;width:100%}#radarDetails{display:flex;gap:24px;flex-wrap:wrap}#relationshipPlot svg{display:block;width:100%;max-width:980px;margin:12px auto}#relationshipPlot a:focus-visible circle{stroke:black;stroke-width:4}.chart-profile-link{display:block;margin:6px 0;font-size:12px;text-align:left}@media(max-width:650px){.chart-selectors{grid-template-columns:1fr}.radar-dimensions{gap:10px}#relationshipPlot{overflow:auto}#relationshipPlot svg{min-width:600px}}
</style>
<style>
.sorting-toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;color:white;font-size:12px;margin:18px 0}.sorting-toolbar button{font-size:11px}.sort-pages{margin-left:auto;display:flex;align-items:center;gap:9px}.sorting-scroll{overflow:auto}.sorting-stage{position:relative;width:100%;min-width:760px;height:760px;background:#002FA7;border:1px solid #ffffff55}.sorting-orbit{position:absolute;left:12%;top:12%;width:76%;height:76%;border:1px dashed #ffffff44;border-radius:50%;pointer-events:none}.sort-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:220px;color:white;text-align:center}.sort-center>p{font-size:11px;margin:12px 0}.sort-photo{width:200px;margin:auto;background:white;color:black;padding:7px;cursor:grab;touch-action:none;user-select:none;box-shadow:0 8px 25px #00000033}.sort-photo:active{cursor:grabbing}.sort-photo img{display:block;width:186px;height:240px;object-fit:contain;pointer-events:none}.sort-photo span{display:block;font-size:11px;padding-top:6px}.sort-folder{position:absolute;transform:translate(-50%,-50%);width:150px;height:132px;background:white;border:2px solid white;padding:10px;color:black;text-align:left;overflow:visible}.sort-folder:hover,.sort-folder:focus-visible,.sort-folder.sort-drop-active{background:white;border-color:white;outline:3px solid white;outline-offset:5px}.sort-folder.sort-drop-active{transform:translate(-50%,-50%) scale(1.04)}.folder-tab{position:absolute;left:-2px;top:-12px;width:52px;height:13px;background:white;border:2px solid white;border-bottom:0}.folder-title{display:block;color:#002FA7;font-size:12px;font-weight:600}.folder-thumbs{display:flex;gap:4px;height:56px;align-items:center;margin:5px 0}.folder-thumbs img{height:52px;width:37px;object-fit:cover;pointer-events:none}.folder-count{font-size:10px;color:#00000099}.folder-plus{font-size:30px;color:#002FA7}.sort-new{border-style:dashed;background:#002FA7;color:white}.sort-new .folder-title,.sort-new .folder-count,.sort-new .folder-plus{color:white}.sort-new:hover,.sort-new:focus-visible,.sort-new.sort-drop-active{background:#002FA7}.sort-new .folder-tab{background:#002FA7}.sort-preview{background:white;padding:20px;margin-top:18px}.sort-preview-title h2{font-size:18px;margin-top:0}.sort-preview-photos{display:flex;gap:8px;overflow:auto;max-height:210px}.sort-preview-item{padding:5px;min-width:85px;text-align:center;font-size:10px}.sort-preview-item img{display:block;height:115px;width:75px;object-fit:cover;pointer-events:none}.sort-preview-item span{display:block;margin-top:4px;max-width:75px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.sort-drag-ghost{position:fixed;width:125px;height:155px;object-fit:contain;background:white;border:4px solid white;box-shadow:0 10px 35px #00000066;z-index:99999;pointer-events:none;transform:translate(-50%,-50%) rotate(5deg)}.sort-save-note{font-size:11px;color:white}.sort-finished{padding:20px;background:white;color:black}.sort-finished p{font-size:12px}@media(max-width:650px){.sort-pages{margin-left:0}.sorting-stage{height:700px}.sort-folder{width:132px}.sort-photo{width:170px}.sort-photo img{width:156px;height:220px}.sort-center{width:190px}}

</style>
<style>
.filtered-analysis-layout{display:grid;grid-template-columns:310px minmax(0,1fr);gap:20px;align-items:start}.analysis-filter-panel{padding:20px}.analysis-map-panel{padding:20px;min-width:0;position:sticky;top:15px}.analysis-map-panel .geographic-map{height:610px}.analysis-filter-row{display:grid;grid-template-columns:minmax(0,1fr) 28px;gap:7px;padding:14px 0;border-bottom:1px solid #00000026}.analysis-filter-row label{font-size:11px;grid-column:1}.analysis-filter-row select{display:block;width:100%;max-width:100%;margin:4px 0 0;padding:8px;font-size:11px}.analysis-filter-row button{grid-column:2;grid-row:1/3;align-self:center;padding:3px;font-size:20px;border:0}.filter-search-label{font-size:11px;display:block}.filter-search-label input{display:block;width:100%;margin-top:5px}.filter-actions{display:flex;gap:8px;margin:16px 0}.filter-actions button{font-size:11px;padding:8px}.filtered-photo-results{display:grid;gap:6px;max-height:370px;overflow:auto}.filtered-photo-result{display:flex;align-items:center;gap:10px;text-align:left;padding:6px;font-size:11px}.filtered-photo-result img{width:40px;height:50px;object-fit:cover}.filtered-photo-result small{display:block;font-size:10px;color:#00000099}.analysis-map-panel .overview-map-toolbar{flex-wrap:wrap}@media(max-width:1050px){.filtered-analysis-layout{grid-template-columns:1fr}.analysis-map-panel{position:static}.analysis-map-panel .geographic-map{height:450px}.filtered-photo-results{grid-template-columns:repeat(auto-fill,minmax(140px,1fr));max-height:210px}}

</style>
<style>
.filtered-analysis-layout{display:grid;grid-template-columns:310px minmax(0,1fr);gap:20px;align-items:start}.analysis-filter-panel{padding:20px}.analysis-map-panel{padding:20px;min-width:0;position:sticky;top:15px}.analysis-map-panel .geographic-map{height:610px}.analysis-filter-row{display:grid;grid-template-columns:minmax(0,1fr) 28px;gap:7px;padding:14px 0;border-bottom:1px solid #00000026}.analysis-filter-row label{font-size:11px;grid-column:1}.analysis-filter-row select{display:block;width:100%;max-width:100%;margin:4px 0 0;padding:8px;font-size:11px}.analysis-filter-row button{grid-column:2;grid-row:1/3;align-self:center;padding:3px;font-size:20px;border:0}.filter-search-label{font-size:11px;display:block}.filter-search-label input{display:block;width:100%;margin-top:5px}.filter-actions{display:flex;gap:8px;margin:16px 0}.filter-actions button{font-size:11px;padding:8px}.filtered-photo-results{display:grid;gap:6px;max-height:370px;overflow:auto}.filtered-photo-result{display:flex;align-items:center;gap:10px;text-align:left;padding:6px;font-size:11px}.filtered-photo-result img{width:40px;height:50px;object-fit:cover}.filtered-photo-result small{display:block;font-size:10px;color:#00000099}.analysis-map-panel .overview-map-toolbar{flex-wrap:wrap}@media(max-width:1050px){.filtered-analysis-layout{grid-template-columns:1fr}.analysis-map-panel{position:static}.analysis-map-panel .geographic-map{height:450px}.filtered-photo-results{grid-template-columns:repeat(auto-fill,minmax(140px,1fr));max-height:210px}}
.analysis-content{min-width:0;display:grid;gap:18px}.analysis-content .analysis-map-panel{position:static}.analysis-view-switch{display:flex;gap:0;justify-self:start;background:white;padding:4px}.analysis-view-switch button{border:0;background:white;color:#002FA7;min-width:75px}.analysis-view-switch button[aria-pressed=true]{background:#002FA7;color:white}.analysis-gallery-panel{padding:20px;min-width:0}.facade-gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px}.facade-gallery-card{padding:0;text-align:left;background:white;min-width:0;overflow:hidden}.facade-gallery-card:hover{background:white;outline:2px solid #002FA7;outline-offset:2px}.facade-gallery-card>img{display:block;width:100%;height:235px;object-fit:contain;background:#00000006}.gallery-card-info{padding:12px;display:grid;gap:5px;font-size:10px}.gallery-card-info strong{font-size:12px}.gallery-no-location{color:#002FA7}.analysis-map-panel[hidden],.analysis-gallery-panel[hidden]{display:none}.gallery-preview-dialog{width:calc(100vw - 50px);max-width:1250px;height:calc(100vh - 60px);max-height:100vh;padding:22px;border-radius:0}.gallery-preview-header{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #00000026;padding-bottom:15px;margin-bottom:18px}.gallery-preview-header h2{margin:0}.gallery-preview-header>button{font-size:24px;border:0}.gallery-preview-layout{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(250px,1fr);gap:25px;height:calc(100% - 155px);min-height:220px}.gallery-preview-image{width:100%;height:100%;object-fit:contain;min-height:0}.gallery-preview-tags{overflow:auto;padding-right:10px;font-size:12px}.gallery-preview-tags .review-row{font-size:11px}.gallery-preview-footer{display:flex;justify-content:space-between;align-items:center;gap:12px;padding-top:18px;border-top:1px solid #00000026;margin-top:15px}@media(max-width:650px){.facade-gallery{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.facade-gallery-card>img{height:180px}.gallery-preview-dialog{width:95vw;padding:15px}.gallery-preview-layout{display:block;overflow:auto}.gallery-preview-image{height:45vh}.gallery-preview-tags{overflow:visible;padding:0}.gallery-preview-footer button{font-size:11px;padding:8px}}

</style>
<style>
.comparison-toolbar{display:flex;justify-content:flex-end}.comparison-toolbar button{background:white;color:#002FA7}.comparison-graph{padding:20px;margin-bottom:18px;min-width:0}.comparison-heading{display:flex;justify-content:space-between;align-items:center;gap:10px}.comparison-heading h2{font-size:20px}.comparison-heading button{font-size:11px}.comparison-selectors{display:grid;grid-template-columns:1fr 1fr;gap:15px}.comparison-selectors label{font-size:11px}.comparison-selectors select{display:block;width:100%;max-width:100%;font-size:12px;margin:6px 0}.comparison-svg svg{display:block;width:100%;max-width:1000px;margin:auto}.comparison-svg a:focus-visible circle{stroke:black;stroke-width:4}.comparison-photo-link{display:block;margin:5px 0;font-size:11px}.comparison-svg{overflow:auto}@media(max-width:650px){.comparison-selectors{grid-template-columns:1fr}.comparison-svg svg{min-width:650px}.comparison-heading{align-items:flex-start}}


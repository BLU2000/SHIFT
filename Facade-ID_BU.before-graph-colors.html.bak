</script>
<script>/* Dependency-free SVG analysis. One observation represents one facade type. */
let analysisSettings={radarDims:['windows','relief','enclosure','surroundingGreen'],radarA:'',radarB:'',x:'windows',y:'enclosure'};
const analysisDimensions=[
  {key:'windows',label:'Window-to-wall ratio',scope:'type',quantitative:true,radar:true},
  {key:'share',label:'Share of entire façade',scope:'type',quantitative:true,radar:true},
  {key:'relief',label:'Relief',scope:'type',values:['Flat','Moderately articulated','Strongly articulated'],radar:true},
  {key:'enclosure',label:'Threshold enclosure',scope:'type',values:['Low','Medium','High'],radar:true,threshold:true},
  {key:'depth',label:'Threshold depth',scope:'type',values:['Under 1 m','1 m or more'],radar:true,threshold:true},
  {key:'surroundingGreen',label:'Surrounding greenery',scope:'context',values:['None','Low','Medium','High'],radar:true},
  {key:'streetRatio',label:'Street width / building height',scope:'context',values:['Street width < building height','Street width = building height','Street width > building height'],radar:true},
  {key:'thermal',label:'Thermal envelope',scope:'type',values:['Uninsulated','Insulated'],radar:true},
  {key:'kind',label:'Façade type',scope:'type',values:['Punched-window façade','Loggia','Semi-loggia','Balcony','Bay window','French balcony','Other']},
  {key:'material',label:'Structural material',scope:'type',values:['Masonry','Concrete','Steel','Timber','Other']},
  {key:'reveal',label:'Window reveal depth',scope:'type',values:['Flush','Medium','Deep']},
  {key:'setting',label:'Setting',scope:'context',values:['Street','Courtyard','Other']},
  {key:'orientation',label:'Orientation',scope:'context',values:['North','East','South','West']}
];
function restoreAnalysisSettings(value){
  if(!value||typeof value!=='object')return;
  if(Array.isArray(value.radarDims))analysisSettings.radarDims=[...new Set(value.radarDims.filter(k=>analysisDimensions.some(d=>d.key===k&&d.radar)))];
  for(const key of ['radarA','radarB'])if(typeof value[key]==='string')analysisSettings[key]=value[key];
  for(const key of ['x','y'])if(analysisDimensions.some(d=>d.key===value[key]))analysisSettings[key]=value[key];
}
function analysisProfiles(){return photos.flatMap(p=>(records[p.id]?.types||[]).flatMap((type,index)=>type.kind?[{key:p.id+'|'+index,photo:p,type,index,record:records[p.id],label:p.name+' · Type '+(index+1)+' · '+type.kind}]:[]));}
function analysisValue(profile,dimension,normalized=false){
  if(dimension.threshold&&thresholdValue(profile.type)!=='Yes')return null;
  const raw=(dimension.scope==='context'?profile.record.context:profile.type)[dimension.key];
  if(dimension.quantitative){const value={'0':0,'¼':.25,'⅓':1/3,'½':.5,'⅔':2/3,'¾':.75,'1':1}[raw];return value===undefined?null:{value,raw};}
  const index=dimension.values.indexOf(raw);if(index<0)return null;
  return {value:normalized?index/(dimension.values.length-1):index,raw};
}
function mountAnalysisCharts(){
  const profiles=analysisProfiles();
  const options=selected=>profiles.map(p=>`<option value="${esc(p.key)}" ${p.key===selected?'selected':''}>${esc(p.label)}</option>`).join('');
  if(!profiles.some(p=>p.key===analysisSettings.radarA))analysisSettings.radarA=profiles[0]?.key||'';
  if(!profiles.some(p=>p.key===analysisSettings.radarB))analysisSettings.radarB=(profiles[1]||profiles[0])?.key||'';
  const radarCard=document.getElementById('radar').closest('section');
  radarCard.classList.add('analysis-wide');
  radarCard.innerHTML=`<h2>Radar comparison</h2><p class="hint">Choose at least three dimensions and two façade types. Photo-level dimensions apply to every type in that photo. Ordered categories are spaced evenly from 0 to 1; higher values are not necessarily better. Unknown and not-applicable values remain missing.</p><fieldset class="radar-dimensions"><legend>Dimensions</legend>${analysisDimensions.filter(d=>d.radar).map(d=>`<label><input type="checkbox" data-radar-dimension="${d.key}" ${analysisSettings.radarDims.includes(d.key)?'checked':''}>${esc(d.label)}${d.scope==='context'?' (photo)':''}</label>`).join('')}</fieldset><div class="chart-selectors"><label>Profile A<select id="compareA">${options(analysisSettings.radarA)}</select></label><label>Profile B<select id="compareB">${options(analysisSettings.radarB)}</select></label></div><div id="radar"></div><div id="radarDetails" class="hint"></div>`;
  const pair=document.createElement('section');pair.className='insight-card analysis-wide';pair.id='relationshipCard';
  pair.innerHTML=`<h2>Attribute relationship</h2><p class="hint">One observation per described façade type. Photo-level attributes repeat for each of its types. Unknown, missing, and not-applicable answers are excluded. Larger bubbles contain multiple observations; select one to explore its profiles.</p><div class="chart-selectors"><label>X axis<select id="relationshipX"></select></label><label>Y axis<select id="relationshipY"></select></label></div><div id="relationshipPlot"></div><p id="relationshipCount" class="hint"></p><div id="relationshipSelection"></div>`;
  radarCard.after(pair);
  for(const [id,key]of [['relationshipX','x'],['relationshipY','y']])document.getElementById(id).innerHTML=analysisDimensions.map(d=>`<option value="${d.key}" ${analysisSettings[key]===d.key?'selected':''}>${esc(d.label)}${d.scope==='context'?' (photo)':''}</option>`).join('');
  renderCustomRadar();renderRelationship();
}
function renderCustomRadar(){
  const target=document.getElementById('radar'),details=document.getElementById('radarDetails');
  if(!target||!details)return;
  const dims=analysisSettings.radarDims.map(k=>analysisDimensions.find(d=>d.key===k)).filter(Boolean);
  if(dims.length<3){target.innerHTML='<p class="empty">Select at least three dimensions to draw a radar diagram.</p>';details.textContent='';return;}
  const profiles=analysisProfiles(),selected=[analysisSettings.radarA,analysisSettings.radarB].map(key=>profiles.find(p=>p.key===key));
  if(!selected.some(Boolean)){target.innerHTML='<p class="empty">Describe a façade type to start comparing profiles.</p>';details.textContent='';return;}
  const pos=(i,value)=>[300+Math.sin(i*2*Math.PI/dims.length)*value*120,200-Math.cos(i*2*Math.PI/dims.length)*value*120];
  let svg='<svg viewBox="0 0 600 420" role="img" aria-label="Radar diagram with selected dimensions">';
  for(const fraction of [.25,.5,.75,1])svg+=`<polygon points="${dims.map((_,i)=>pos(i,fraction).join(',')).join(' ')}" fill="none" stroke="#00000026"/><text x="304" y="${200-fraction*120-3}" font-size="9" fill="#00000099">${fraction}</text>`;
  dims.forEach((d,i)=>{const [x,y]=pos(i,1),[tx,ty]=pos(i,1.38);svg+=`<line x1="300" y1="200" x2="${x}" y2="${y}" stroke="#00000020"/><text x="${tx}" y="${ty}" text-anchor="middle" font-size="10">${esc(d.label)}</text>`;});
  const notes=[];
  selected.forEach((p,j)=>{if(!p)return;const color=j?'#000000':'#002FA7',values=dims.map(d=>analysisValue(p,d,true)),missing=dims.filter((d,i)=>!values[i]).map(d=>d.label);
    if(!missing.length)svg+=`<polygon points="${values.map((v,i)=>pos(i,v.value).join(',')).join(' ')}" fill="${color}" fill-opacity=".08" stroke="${color}" stroke-width="2" ${j?'stroke-dasharray="5 3"':''}/>`;
    else values.forEach((v,i)=>{const next=(i+1)%dims.length;if(v&&values[next]){const [x1,y1]=pos(i,v.value),[x2,y2]=pos(next,values[next].value);svg+=`<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${color}" stroke-width="2"/>`;}});
    values.forEach((v,i)=>{if(!v)return;const [x,y]=pos(i,v.value);svg+=`<circle cx="${x}" cy="${y}" r="4" fill="${color}"><title>${esc(p.label+' · '+dims[i].label+': '+v.raw)}</title></circle>`;});
    notes.push(`<p style="color:${color}"><b>${j?'B':'A'} · ${esc(p.label)}</b>${missing.length?'<br>Missing: '+esc(missing.join(', ')):''}</p>`);
  });
  target.innerHTML=svg+'</svg>';details.innerHTML=notes.join('');
}
let relationshipGroups=[];
function renderRelationship(){
  const x=analysisDimensions.find(d=>d.key===analysisSettings.x),y=analysisDimensions.find(d=>d.key===analysisSettings.y);
  const profiles=analysisProfiles(),valid=profiles.flatMap(p=>{const xv=analysisValue(p,x),yv=analysisValue(p,y);return xv&&yv?[{profile:p,x:xv,y:yv}]:[];});
  const groups=new Map();valid.forEach(p=>{const key=p.x.value+'|'+p.y.value;if(!groups.has(key))groups.set(key,[]);groups.get(key).push(p);});relationshipGroups=[...groups.values()];
  const width=760,height=500,left=150,right=35,top=35,bottom=150,plotW=width-left-right,plotH=height-top-bottom;
  const ticks=d=>d.quantitative?[{value:0,label:'0'},{value:.25,label:'¼'},{value:1/3,label:'⅓'},{value:.5,label:'½'},{value:2/3,label:'⅔'},{value:.75,label:'¾'},{value:1,label:'1'}]:d.values.map((label,value)=>({value,label}));
  const scale=(d,v,length)=>d.quantitative?v*length:(v+.5)/d.values.length*length;
  let svg=`<svg viewBox="0 0 ${width} ${height}" role="img" aria-label="${esc(x.label)} versus ${esc(y.label)}"><rect x="${left}" y="${top}" width="${plotW}" height="${plotH}" fill="white" stroke="#00000055"/>`;
  ticks(x).forEach(t=>{const px=left+scale(x,t.value,plotW);svg+=`<line x1="${px}" y1="${top}" x2="${px}" y2="${top+plotH}" stroke="#00000015"/><text x="${px}" y="${top+plotH+18}" transform="rotate(30 ${px} ${top+plotH+18})" text-anchor="start" font-size="11">${esc(t.label)}</text>`;});
  ticks(y).forEach(t=>{const py=top+plotH-scale(y,t.value,plotH);svg+=`<line x1="${left}" y1="${py}" x2="${left+plotW}" y2="${py}" stroke="#00000015"/><text x="${left-10}" y="${py+4}" text-anchor="end" font-size="11">${esc(t.label)}</text>`;});
  svg+=`<text x="${left+plotW/2}" y="${height-15}" text-anchor="middle" font-size="13">${esc(x.label)}</text><text transform="translate(18 ${top+plotH/2}) rotate(-90)" text-anchor="middle" font-size="13">${esc(y.label)}</text>`;
  relationshipGroups.forEach((g,i)=>{const px=left+scale(x,g[0].x.value,plotW),py=top+plotH-scale(y,g[0].y.value,plotH),radius=Math.min(24,7+Math.sqrt(g.length-1)*3);svg+=`<a href="#" data-relationship-group="${i}" aria-label="${esc(g.length+' profiles: '+g[0].x.raw+' / '+g[0].y.raw)}"><circle cx="${px}" cy="${py}" r="${radius}" fill="#002FA7" fill-opacity=".8" stroke="white" stroke-width="2"><title>${esc(g[0].x.raw+' / '+g[0].y.raw+' · '+g.length+' observation(s)')}</title></circle>${g.length>1?`<text x="${px}" y="${py+4}" text-anchor="middle" font-size="11" fill="white">${g.length}</text>`:''}</a>`;});
  document.getElementById('relationshipPlot').innerHTML=svg+'</svg>';
  document.getElementById('relationshipCount').textContent=`${valid.length} of ${profiles.length} façade types plotted · ${profiles.length-valid.length} excluded for missing or inapplicable answers.`;
  document.getElementById('relationshipSelection').innerHTML=valid.length?'':'<p class="empty">No observations have answers for both selected attributes yet.</p>';
}
document.addEventListener('change',event=>{
  const element=event.target;
  if(element.dataset.radarDimension){analysisSettings.radarDims=[...document.querySelectorAll('[data-radar-dimension]:checked')].map(e=>e.dataset.radarDimension);renderCustomRadar();persist();}
  if(['compareA','compareB'].includes(element.id)){analysisSettings[element.id==='compareA'?'radarA':'radarB']=element.value;renderCustomRadar();persist();}
  if(['relationshipX','relationshipY'].includes(element.id)){analysisSettings[element.id==='relationshipX'?'x':'y']=element.value;renderRelationship();persist();}
});
document.addEventListener('click',event=>{
  const group=event.target.closest('[data-relationship-group]');
  if(group){event.preventDefault();const values=relationshipGroups[+group.dataset.relationshipGroup]||[];document.getElementById('relationshipSelection').innerHTML=values.map(v=>`<button class="chart-profile-link" data-analysis-profile="${esc(v.profile.key)}">${esc(v.profile.label)}</button>`).join('');}
  const link=event.target.closest('[data-analysis-profile]');
  if(link){const profile=analysisProfiles().find(p=>p.key===link.dataset.analysisProfile);if(profile){current=profile.photo.id;typeIndex=profile.index;step=3;view='entry';render();}}
});
</script>
<script>/* Photos are decoded locally and embedded as portable JPEGs. */
function mergeUploadedPhotos(incoming) {
  for (const photo of incoming) {
    if (!photo?.uploaded || deletedPhotoIds.has(photo.id) || typeof photo.id !== 'string' || !/^photo-[a-f0-9]{64}$/.test(photo.id) || photos.some(p => p.id === photo.id)) continue;
    if (typeof photo.name !== 'string' || typeof photo.src !== 'string' || !/^data:image\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(photo.src)) throw new Error('Invalid uploaded photo');
    photos.push({id: photo.id, name: photo.name, src: photo.src, uploaded: true, addedAt: photo.addedAt});
  }
}
async function prepareUploadedPhoto(file) {
  if (!/\.(jpe?g|png|webp|gif|avif|heic|heif)$/i.test(file.name)) throw new Error('Use a JPEG, PNG, WebP, GIF, AVIF, or browser-supported HEIC photo.');
  const hash = await crypto.subtle.digest('SHA-256', await file.arrayBuffer());
  const id = 'photo-' + [...new Uint8Array(hash)].map(v => v.toString(16).padStart(2, '0')).join('');
  if (photos.some(p => p.id === id)) return null;
  const url = URL.createObjectURL(file);
  try {
    const image = new Image();
    await new Promise((resolve, reject) => { image.onload = resolve; image.onerror = () => reject(new Error('This browser cannot open this photo. Convert it to JPEG or PNG first.')); image.src = url; });
    const scale = Math.min(1, 1600 / Math.max(image.naturalWidth, image.naturalHeight));
    const canvas = document.createElement('canvas');
    canvas.width = Math.max(1, Math.round(image.naturalWidth * scale));
    canvas.height = Math.max(1, Math.round(image.naturalHeight * scale));
    const context = canvas.getContext('2d');
    context.fillStyle = '#ffffff'; context.fillRect(0, 0, canvas.width, canvas.height);
    context.drawImage(image, 0, 0, canvas.width, canvas.height);
    return {id, name: file.name.replace(/\.[^.]+$/, ''), src: canvas.toDataURL('image/jpeg', .85), uploaded: true, addedAt: new Date().toISOString()};
  } finally { URL.revokeObjectURL(url); }
}
async function addPhotos(files) {
  const button = document.getElementById('addPhotos');
  button.disabled = true;
  const errors = [], added = []; let duplicates = 0;
  try {
    for (const file of files) {
      button.textContent = `Adding ${added.length + duplicates + errors.length + 1} / ${files.length}…`;
      try {
        const photo = await prepareUploadedPhoto(file);
        if (!photo) { duplicates++; continue; }
        deletedPhotoIds.delete(photo.id);photos.push(photo); added.push(photo);
      } catch (error) { errors.push(`${file.name}: ${error.message}`); }
    }
    if (added.length) {
      current = added[0].id; step = 0; typeIndex = 0; view = 'entry';
      document.getElementById('search').value = ''; document.getElementById('statusFilter').value = 'all';
      await persist(); render();
    }
    document.getElementById('uploadStatus').textContent = `${added.length} photo(s) added.${duplicates ? ` ${duplicates} duplicate(s) skipped.` : ''}${errors.length ? ' '+errors.join(' ') : ''}`;
  } finally { button.disabled = false; button.textContent = '+ Add photos'; document.getElementById('photoFiles').value = ''; }
}
document.addEventListener('click', event => { if (event.target.closest('#addPhotos')) document.getElementById('photoFiles').click(); });
document.addEventListener('change', event => { if (event.target.id === 'photoFiles' && event.target.files.length) addPhotos([...event.target.files]); });
</script>
<script>/* Save revision is distinct from the answer-file schema version. */
let saveMeta = {revision: 0, initials: '', savedAt: null};
function restoreSaveMeta(value) {
  if (value && Number.isSafeInteger(value.revision) && value.revision >= saveMeta.revision)
    saveMeta = {revision: value.revision, initials: String(value.initials || ''), savedAt: value.savedAt || null};
  updateRevisionLabel();
}
function revisionLabel(n) { return 'v' + String(n).padStart(3, '0'); }
function saveFilename(initials, revision) { return `Facade-ID_${initials}_${revisionLabel(revision)}.html`; }
function updateRevisionLabel() {
  const label = document.getElementById('revisionLabel');
  if (label) label.textContent = revisionLabel(saveMeta.revision) + (saveMeta.initials ? ' · ' + saveMeta.initials : '');
}
function openSaveDialog() {
  const dialog = document.getElementById('saveDialog');
  document.getElementById('saveInitials').value = saveMeta.initials;
  updateSavePreview();
  if (!dialog.open) dialog.showModal();
  document.getElementById('saveInitials').focus();
}
function updateSavePreview() {
  const input = document.getElementById('saveInitials');
  input.setCustomValidity('');
  document.getElementById('saveFilenamePreview').textContent = saveFilename(input.value.trim().toUpperCase() || 'INITIALS', saveMeta.revision + 1);
}
document.addEventListener('input', event => {
  if (event.target.id === 'saveInitials') updateSavePreview();
});
document.addEventListener('click', event => {
  if (event.target.closest('#cancelSave')) document.getElementById('saveDialog').close();
});
document.addEventListener('submit', async event => {
  if (event.target.id !== 'saveForm') return;
  event.preventDefault();
  const input = document.getElementById('saveInitials');
  const initials = input.value.trim().toUpperCase();
  if (!/^[A-Z0-9]{1,12}$/.test(initials)) {
    input.setCustomValidity('Enter 1–12 letters or numbers, for example BU.'); input.reportValidity(); return;
  }
  document.getElementById('saveDialog').close();
  await saveHtml(initials);
});
</script>
<script>/* OpenFreeMap + MapLibre location picker. Application records stay local. */
let locationMap = null, locationMarker = null, liveMapsEnabled = false;
let lastMapView = null, mapSyncTimer = null, mapLoadTimer = null;
const LIVE_MAP_STYLE = 'https://tiles.openfreemap.org/styles/positron';

function validPosition(location) {
  if (!location || location.lat === '' || location.lng === '' || location.lat == null || location.lng == null) return null;
  const lat = Number(location.lat), lng = Number(location.lng);
  return Number.isFinite(lat) && Number.isFinite(lng) && Math.abs(lat) <= 90 && Math.abs(lng) <= 180 ? {lat, lng} : null;
}

function mapPickerMarkup() {
  const photo = photos.find(p => p.id === current);
  return `<section class="location-picker" aria-label="Choose photo location on a map">
    <div class="map-heading"><strong>Pin the photograph</strong><a id="osmLocationLink" target="_blank" rel="noopener">Open in OpenStreetMap ↗</a></div>
    <p class="hint">Open the live street map, then click to place a pin or drag the pin to move it. Zoom in to select the correct building.</p>
    <button type="button" id="openLocationMap">${liveMapsEnabled ? 'Reload live map' : 'Open live map'}</button>
    <div id="locationMap" class="location-map" hidden aria-label="Interactive location map"></div>
    <p id="locationMapStatus" class="hint" role="status">Live map by OpenFreeMap · OpenStreetMap data · Internet required. Photos and answers stay on your device.</p>
    <div class="map-actions"><button type="button" id="pinMapCenter" disabled>Pin map center</button><button type="button" id="clearMapPin">Clear location</button>${photo.location ? '<button type="button" id="restorePhotoGps">Restore photo GPS</button>' : ''}</div>
  </section>`;
}

function setMapStatus(text, warning = false) {
  const status = document.getElementById('locationMapStatus');
  if (status) { status.textContent = text; status.classList.toggle('error', warning); }
}

function updateOsmLink() {
  const link = document.getElementById('osmLocationLink');
  if (!link) return;
  const position = validPosition(rec().location);
  const center = position || lastMapView || photos.map(p => validPosition(locationFor(p))).find(Boolean) || {lat: 48.14, lng: 11.58};
  link.href = position
    ? `https://www.openstreetmap.org/?mlat=${position.lat}&mlon=${position.lng}#map=19/${position.lat}/${position.lng}`
    : `https://www.openstreetmap.org/#map=12/${center.lat}/${center.lng}`;
}

function disposeLocationMap() {
  clearTimeout(mapSyncTimer); clearTimeout(mapLoadTimer);
  if (locationMap) {
    const center = locationMap.getCenter();
    lastMapView = {lat: center.lat, lng: center.lng, zoom: locationMap.getZoom()};
    locationMap.remove();
  }
  locationMap = null; locationMarker = null;
}

function mountLocationPicker() {
  updateOsmLink();
  if (liveMapsEnabled) openLocationMap();
}

function writeMapPosition(position, source) {
  const lat = Math.max(-90, Math.min(90, position.lat));
  const lng = ((position.lng + 180) % 360 + 360) % 360 - 180;
  const record = rec();
  record.location.lat = lat.toFixed(7); record.location.lng = lng.toFixed(7);
  record.location.source = source;
  for (const key of ['lat', 'lng']) {
    const input = document.getElementById(key);
    if (input) input.value = record.location[key];
  }
  changed(); syncLocationMarker(false); updateOsmLink();
  setMapStatus('Pin updated. Coordinates save automatically in this browser.');
}

function syncLocationMarker(recenter = false) {
  updateOsmLink();
  if (!locationMap) return;
  const position = validPosition(rec().location);
  if (!position) {
    if (locationMarker) locationMarker.remove();
    locationMarker = null;
    return;
  }
  if (!locationMarker) {
    locationMarker = new maplibregl.Marker({color: '#002FA7', draggable: true})
      .setLngLat([position.lng, position.lat]).addTo(locationMap);
    const element = locationMarker.getElement();
    element.setAttribute('aria-label', 'Photo location pin. Drag to move, or edit the coordinate fields.');
    locationMarker.on('dragend', () => writeMapPosition(locationMarker.getLngLat(), 'Manual map pin'));
  } else locationMarker.setLngLat([position.lng, position.lat]);
  if (recenter) locationMap.jumpTo({center: [position.lng, position.lat], zoom: Math.max(16, locationMap.getZoom())});
}

function scheduleMapSync() {
  clearTimeout(mapSyncTimer);
  mapSyncTimer = setTimeout(() => syncLocationMarker(true), 300);
}

function openLocationMap() {
  const container = document.getElementById('locationMap');
  if (!container || locationMap) return;
  liveMapsEnabled = true; container.hidden = false;
  const button = document.getElementById('openLocationMap');
  button.hidden = true;
  if (typeof maplibregl === 'undefined') {
    setMapStatus('Map controls could not load. Enter coordinates manually or use the OpenStreetMap link.', true);
    button.hidden = false; return;
  }
  const position = validPosition(rec().location);
  const nearby = photos.map(p => validPosition(locationFor(p))).find(Boolean);
  const center = position || lastMapView || nearby || {lat: 48.14, lng: 11.58};
  try {
    const map = new maplibregl.Map({container, style: LIVE_MAP_STYLE,
      center: [center.lng, center.lat], zoom: position ? 17 : lastMapView?.zoom || 12,
      attributionControl: {compact: false}, maxZoom: 20});
    locationMap = map;
    map.addControl(new maplibregl.NavigationControl({showCompass: false}), 'top-right');
    map.addControl(new maplibregl.AttributionControl({compact: false, customAttribution: '<a href="https://openfreemap.org/" target="_blank" rel="noopener">OpenFreeMap</a>'}), 'bottom-left');
    document.getElementById('pinMapCenter').disabled = false;
    syncLocationMarker();
    setMapStatus('Loading street map… You can pan, zoom, and click to place the pin.');
    map.on('click', event => {
      if (locationMap === map) writeMapPosition(event.lngLat, 'Manual map pin');
    });
    map.on('load', () => {
      clearTimeout(mapLoadTimer);
      if (locationMap === map) setMapStatus('Click the map to place the pin. Drag it to adjust. Changes save automatically.');
    });
    map.on('error', () => {
      if (locationMap !== map) return;
      setMapStatus('Some map data could not load. Check your connection. Coordinates and the OpenStreetMap link still work.', true);
      button.hidden = false;
    });
    mapLoadTimer = setTimeout(() => {
      if (locationMap === map && !map.isStyleLoaded()) {
        setMapStatus('The live map is taking too long to load. Check your connection or use the OpenStreetMap link.', true);
        button.hidden = false;
      }
    }, 15000);
  } catch (error) {
    disposeLocationMap(); button.hidden = false;
    setMapStatus('The live map is unavailable in this browser. Enter coordinates manually or use the OpenStreetMap link.', true);
  }
}

document.addEventListener('click', event => {
  const button = event.target.closest('button');
  if (!button) return;
  if (button.id === 'openLocationMap') { disposeLocationMap(); openLocationMap(); }
  if (button.id === 'pinMapCenter' && locationMap) writeMapPosition(locationMap.getCenter(), 'Manual map pin');
  if (button.id === 'clearMapPin') {
    rec().location.lat = ''; rec().location.lng = ''; rec().location.source = 'Manually cleared';
    document.getElementById('lat').value = ''; document.getElementById('lng').value = '';
    changed(); syncLocationMarker(); setMapStatus('Location cleared. Click the map to choose a new position.');
  }
  if (button.id === 'restorePhotoGps') {
    const photo = photos.find(p => p.id === current);
    if (photo.location) { writeMapPosition(photo.location, 'Photo GPS metadata'); syncLocationMarker(true); }
  }
});

let overviewMap=null,overviewMarkers=[],overviewPoints=[],overviewLoadTimer=null;
function disposeOverviewMap(){
  clearTimeout(overviewLoadTimer);
  overviewMarkers.forEach(marker=>marker.remove());overviewMarkers=[];
  if(overviewMap)overviewMap.remove();overviewMap=null;
}
function fitOverviewPhotos(){
  if(!overviewMap||!overviewPoints.length)return;
  const bounds=new maplibregl.LngLatBounds();overviewPoints.forEach(p=>{const v=validPosition(locationFor(p));bounds.extend([v.lng,v.lat]);});
  overviewMap.fitBounds(bounds,{padding:55,maxZoom:17,duration:0});
}
function mountOverviewMap(list){
  overviewPoints=list.filter(p=>validPosition(locationFor(p)));
  const host=document.getElementById('mapPlot'),fallback=host.innerHTML;
  host.innerHTML=`<div class="overview-map-toolbar"><span>${overviewPoints.length} located · ${list.length-overviewPoints.length} without coordinates</span><button type="button" id="fitOverviewPhotos">Show all photos</button></div><div id="geographicMap" class="geographic-map" aria-label="Interactive map of all photo locations"></div><p id="overviewMapStatus" class="hint" role="status">Loading live street map… Internet required.</p><details id="overviewMapFallback" hidden><summary>Offline coordinate overview</summary>${fallback}</details>`;
  const status=(message,failed=false)=>{const label=document.getElementById('overviewMapStatus');if(label)label.textContent=message;const backup=document.getElementById('overviewMapFallback');if(backup)backup.hidden=!failed;};
  if(window.DISABLE_LIVE_OVERVIEW_FOR_TESTS){status('Live overview disabled for automated form checks.');return;}
  if(typeof maplibregl==='undefined'){status('Live map controls are unavailable. The offline coordinate overview is available below.',true);return;}
  try{
    const first=overviewPoints[0]&&validPosition(locationFor(overviewPoints[0]));
    const map=new maplibregl.Map({container:'geographicMap',style:LIVE_MAP_STYLE,center:first?[first.lng,first.lat]:[11.58,48.14],zoom:12,attributionControl:{compact:false},maxZoom:20});overviewMap=map;
    map.addControl(new maplibregl.NavigationControl({showCompass:false}),'top-right');
    const groups=new Map();overviewPoints.forEach(photo=>{const location=validPosition(locationFor(photo)),key=location.lat+','+location.lng;if(!groups.has(key))groups.set(key,[]);groups.get(key).push(photo);});
    for(const group of groups.values()){
      const position=validPosition(locationFor(group[0])),element=document.createElement('button');
      element.type='button';element.className='overview-marker';element.textContent=group.length>1?String(group.length):'';
      element.setAttribute('aria-label',group.length>1?group.length+' photos at this location':group[0].name);element.title=group.map(p=>p.name).join(', ');
      const marker=new maplibregl.Marker({element}).setLngLat([position.lng,position.lat]).addTo(map);overviewMarkers.push(marker);
      element.addEventListener('click',event=>{
        event.stopPropagation();
        const content=document.createElement('div');content.className='overview-popup';
        const title=document.createElement('strong');title.textContent=group.length>1?group.length+' photos at this location':group[0].name;content.append(title);
        group.forEach(photo=>{const button=document.createElement('button');button.type='button';button.dataset.photo=photo.id;button.className='overview-photo';const image=document.createElement('img');image.src=photo.src;image.alt='';const text=document.createElement('span');text.textContent=photo.name+' · '+(records[photo.id]?.completed?'Completed':records[photo.id]?.updatedAt?'In progress':'Not started');button.append(image,text);content.append(button);});
        new maplibregl.Popup({maxWidth:'300px'}).setLngLat([position.lng,position.lat]).setDOMContent(content).addTo(map);
      });
    }
    fitOverviewPhotos();
    map.on('load',()=>{clearTimeout(overviewLoadTimer);if(overviewMap===map)status('Scroll or use + / − to zoom. Drag to pan. Select a marker to open its photos.');});
    map.on('error',()=>{if(overviewMap===map)status('Some map data could not load. Check your connection, or use the offline coordinate overview below.',true);});
    overviewLoadTimer=setTimeout(()=>{if(overviewMap===map&&!map.isStyleLoaded())status('The live map is unavailable. Use the offline coordinate overview below.',true);},15000);
  }catch(error){disposeOverviewMap();status('The live map is unavailable in this browser. Use the offline coordinate overview below.',true);}
}
document.addEventListener('click',event=>{if(event.target.closest('#fitOverviewPhotos'))fitOverviewPhotos();});
</script>
<script>
/* Collection deletions never remove the original files from disk. */
let deletedPhotoIds=new Set(),lastDeletedPhoto=null;
function restoreDeletedPhotos(ids){if(Array.isArray(ids))ids.filter(id=>typeof id==='string').forEach(id=>deletedPhotoIds.add(id));}
function applyPhotoDeletions(){
  photos=photos.filter(p=>!deletedPhotoIds.has(p.id));
  for(const id of deletedPhotoIds)delete records[id];
  conflicts=conflicts.filter(c=>!deletedPhotoIds.has(c.id));
  if(!photos.some(p=>p.id===current)){current=photos[0]?.id;step=0;typeIndex=0;}
}
async function deleteCurrentPhoto(){
  const photo=photos.find(p=>p.id===current);if(!photo)return;
  if(!window.confirm(`Delete ${photo.name} from this collection?\n\nThis also removes its saved answers. The original image file on disk is kept. You can undo this deletion until you reload or close the app.`))return;
  lastDeletedPhoto={photo,index:photos.indexOf(photo),record:records[photo.id],conflicts:conflicts.filter(c=>c.id===photo.id)};
  const next=photos[lastDeletedPhoto.index+1]||photos[lastDeletedPhoto.index-1];
  deletedPhotoIds.add(photo.id);applyPhotoDeletions();current=next?.id;step=0;typeIndex=0;view='entry';
  document.getElementById('undoPhotoDelete').hidden=false;
  await persist();render();
}
async function undoPhotoDelete(){
  if(!lastDeletedPhoto)return;
  const item=lastDeletedPhoto;deletedPhotoIds.delete(item.photo.id);
  photos.splice(Math.min(item.index,photos.length),0,item.photo);
  if(item.record)records[item.photo.id]=item.record;
  conflicts.push(...item.conflicts);current=item.photo.id;step=0;typeIndex=0;view='entry';lastDeletedPhoto=null;
  document.getElementById('undoPhotoDelete').hidden=true;
  await persist();render();
}
document.addEventListener('click',event=>{
  if(event.target.closest('#deletePhoto'))deleteCurrentPhoto();
  if(event.target.closest('#undoPhotoDelete'))undoPhotoDelete();
});

</script>
<script>
/* A reusable numeric building-type tag, separate from facade-type descriptions. */
function buildingTypeGroups(){
  const groups=new Map();
  for(const photo of photos){const value=Number(records[photo.id]?.buildingType);if(!Number.isSafeInteger(value)||value<1)continue;if(!groups.has(value))groups.set(value,[]);groups.get(value).push(photo);}
  return [...groups].sort((a,b)=>a[0]-b[0]);
}
function nextBuildingType(){return Math.max(0,...Object.values(records).map(r=>Number.isSafeInteger(r.buildingType)&&r.buildingType>0?r.buildingType:0))+1;}

</script>
<script>
/* Visual building-type grouping. Labels reuse the existing per-photo buildingType field. */
let sortPhotoId=null,sortPage=0,sortHistory=[],sortSkipped=new Set(),sortDrag=null;
function sortQueue(){return photos.filter(p=>!Number.isSafeInteger(records[p.id]?.buildingType));}
function nextSortPhoto(){return sortQueue().find(p=>!sortSkipped.has(p.id))||null;}
function openSortingCanvas(){view='sorting';sortSkipped.clear();sortPhotoId=nextSortPhoto()?.id||null;render();}
function renderSortingCanvas(){
  const groups=buildingTypeGroups(),pages=Math.max(1,Math.ceil(groups.length/6));sortPage=Math.max(0,Math.min(sortPage,pages-1));
  if(!photos.some(p=>p.id===sortPhotoId))sortPhotoId=nextSortPhoto()?.id||null;
  const photo=photos.find(p=>p.id===sortPhotoId),queue=sortQueue(),visible=groups.slice(sortPage*6,sortPage*6+6);
  const targets=[{number:'new',items:[]},...visible.map(([number,items])=>({number,items}))];
  document.getElementById('main').innerHTML=`<div class="intro"><div><div class="eyebrow">Visual sorting</div><h1>Find the families.</h1><p class="muted">Drag the center photo into a folder. Its number becomes the building-type label.</p></div><div><button id="sortBack">Back to tagging</button> <button id="insights">View analysis ↗</button></div></div><div class="sorting-toolbar"><span>${photos.length-queue.length} / ${photos.length} sorted · ${queue.length} unassigned</span><button id="sortUndo" ${sortHistory.length?'':'disabled'}>Undo</button><button id="sortSkip" ${photo?'':'disabled'}>Skip photo</button><button id="sortRestart" ${queue.length?'':'disabled'}>Show unsorted</button><span class="sort-pages"><button id="sortPrev" ${sortPage?'':'disabled'} aria-label="Previous category page">←</button> Folders ${sortPage+1} / ${pages} <button id="sortNext" ${sortPage<pages-1?'':'disabled'} aria-label="Next category page">→</button></span></div><div class="sorting-scroll"><div class="sorting-stage" id="sortingStage"><div class="sorting-orbit" aria-hidden="true"></div>${targets.map((target,i)=>{const angle=-Math.PI/2+i*2*Math.PI/targets.length,x=50+Math.sin(angle)*38,y=50-Math.cos(angle)*38;return `<button class="sort-folder ${target.number==='new'?'sort-new':''}" data-sort-target="${target.number}" style="left:${x}%;top:${y}%" aria-label="${target.number==='new'?'Create a new category':'Assign to category '+target.number}"><span class="folder-tab"></span><span class="folder-title">${target.number==='new'?'+ New category':'Category '+target.number}</span><span class="folder-thumbs">${target.items.slice(-3).map(p=>`<img src="${esc(p.src)}" alt="" draggable="false">`).join('')||'<span class="folder-plus">+</span>'}</span><span class="folder-count">${target.number==='new'?'Drop here to create':target.items.length+' photo(s)'}</span></button>`;}).join('')}<div class="sort-center">${photo?`<div class="sort-photo" data-sort-photo="${esc(photo.id)}" role="img" aria-label="Drag ${esc(photo.name)} to a category"><img src="${esc(photo.src)}" alt="${esc(photo.name)}" draggable="false"><span>${esc(photo.name)}</span></div><p>${records[photo.id]?.buildingType?'Currently category '+records[photo.id].buildingType:'Drag into a folder · or click a folder'}</p>`:`<div class="sort-finished"><strong>${queue.length?'Ready for another look?':'All photos sorted.'}</strong><p>${queue.length?'Use Show unsorted to revisit skipped photos.':'Select a folder preview photo below to move it to a different category.'}</p><button id="sortRestart">${queue.length?'Show unsorted':'Review folders'}</button></div>`}</div></div></div><section class="sort-preview"><div class="sort-preview-title"><h2 id="sortPreviewTitle">Folder preview</h2><p class="hint">Hover or focus a folder to see its contents. Select a thumbnail to move it to another category.</p></div><div id="sortPreviewPhotos" class="sort-preview-photos"></div></section><p class="sort-save-note" role="status" id="sortStatus">Category labels save automatically. Use Save to download the updated HTML.</p>`;
  if(visible.length)showSortPreview(visible[0][0]);
}
function showSortPreview(number){
  const group=buildingTypeGroups().find(([n])=>n===Number(number));
  const title=document.getElementById('sortPreviewTitle'),content=document.getElementById('sortPreviewPhotos');if(!title||!content)return;
  title.textContent=number==='new'?'New category':`Category ${number} · ${group?.[1].length||0} photo(s)`;
  content.innerHTML=group?group[1].map(photo=>`<button data-sort-select="${esc(photo.id)}" class="sort-preview-item" title="Select ${esc(photo.name)} to regroup"><img src="${esc(photo.src)}" alt="${esc(photo.name)}" draggable="false"><span>${esc(photo.name)}</span></button>`).join(''):'<p class="hint">Drop the center photo here to start a new numbered category.</p>';
}
async function sortAssignPhoto(photoId,target){
  if(!photos.some(p=>p.id===photoId))return;
  const number=target==='new'?nextBuildingType():Number(target);
  if(!Number.isSafeInteger(number)||number<1)return;
  const old=records[photoId],record=old||(records[photoId]=blank());
  if(record.buildingType===number)return;
  sortHistory.push({id:photoId,previous:record.buildingType,updatedAt:record.updatedAt,hadRecord:!!old});
  record.buildingType=number;record.updatedAt=new Date().toISOString();
  sortSkipped.delete(photoId);sortPhotoId=nextSortPhoto()?.id||null;
  const groups=buildingTypeGroups();sortPage=Math.floor(groups.findIndex(([n])=>n===number)/6);
  await persist();render();showSortPreview(number);
  const status=document.getElementById('sortStatus');if(status)status.textContent=`Assigned to category ${number}. ${sortQueue().length} photo(s) remaining.`;
}
async function undoSortAssignment(){
  const item=sortHistory.pop();if(!item||!photos.some(p=>p.id===item.id))return;
  const record=records[item.id];if(!record)return;
  if(item.previous===undefined)delete record.buildingType;else record.buildingType=item.previous;
  record.updatedAt=item.updatedAt;
  sortSkipped.delete(item.id);sortPhotoId=item.id;await persist();render();
}
document.addEventListener('click',event=>{
  const button=event.target.closest('button');if(!button)return;
  if(button.id==='sortPhotos')openSortingCanvas();
  if(button.id==='sortBack'){if(sortPhotoId)current=sortPhotoId;view='entry';step=0;typeIndex=0;render();}
  if(button.id==='sortSkip'){if(sortPhotoId)sortSkipped.add(sortPhotoId);sortPhotoId=nextSortPhoto()?.id||null;render();}
  if(button.id==='sortRestart'){sortSkipped.clear();sortPhotoId=nextSortPhoto()?.id||null;render();}
  if(button.id==='sortUndo')undoSortAssignment();
  if(button.id==='sortPrev'){sortPage--;render();}if(button.id==='sortNext'){sortPage++;render();}
  if(button.dataset.sortTarget&&sortPhotoId)sortAssignPhoto(sortPhotoId,button.dataset.sortTarget);
  if(button.dataset.sortSelect){sortPhotoId=button.dataset.sortSelect;render();}
});
document.addEventListener('pointerover',event=>{const folder=event.target.closest('[data-sort-target]');if(folder&&view==='sorting'&&!folder.contains(event.relatedTarget))showSortPreview(folder.dataset.sortTarget);});
document.addEventListener('focusin',event=>{const folder=event.target.closest('[data-sort-target]');if(folder)showSortPreview(folder.dataset.sortTarget);});
document.addEventListener('pointerdown',event=>{
  const photo=event.target.closest('[data-sort-photo]');if(!photo||event.button!==0)return;
  event.preventDefault();photo.setPointerCapture(event.pointerId);
  sortDrag={id:photo.dataset.sortPhoto,pointer:event.pointerId,startX:event.clientX,startY:event.clientY,ghost:null,target:null};
});
document.addEventListener('pointermove',event=>{
  if(!sortDrag||event.pointerId!==sortDrag.pointer)return;
  if(!sortDrag.ghost&&Math.hypot(event.clientX-sortDrag.startX,event.clientY-sortDrag.startY)<8)return;
  if(!sortDrag.ghost){const img=document.createElement('img');img.src=photos.find(p=>p.id===sortDrag.id).src;img.className='sort-drag-ghost';document.body.append(img);sortDrag.ghost=img;}
  sortDrag.ghost.style.left=event.clientX+'px';sortDrag.ghost.style.top=event.clientY+'px';
  const target=document.elementFromPoint(event.clientX,event.clientY)?.closest('[data-sort-target]');
  if(target!==sortDrag.target){sortDrag.target?.classList.remove('sort-drop-active');target?.classList.add('sort-drop-active');sortDrag.target=target;if(target)showSortPreview(target.dataset.sortTarget);}
});
function finishSortDrag(event,cancel=false){
  if(!sortDrag||event.pointerId!==sortDrag.pointer)return;
  const drag=sortDrag;sortDrag=null;drag.ghost?.remove();drag.target?.classList.remove('sort-drop-active');
  if(!cancel&&drag.ghost&&drag.target)sortAssignPhoto(drag.id,drag.target.dataset.sortTarget);
}
document.addEventListener('pointerup',event=>finishSortDrag(event));
document.addEventListener('pointercancel',event=>finishSortDrag(event,true));

</script>
<script>
/* Attribute filtering of photographs, including same-type matching for heterogeneous facades. */
let analysisFilters={search:'',rules:[],mode:'both',graphs:[]},filterSearchTimer=null,filteredAnalysisPhotos=[],galleryPreviewId=null;
function filterDefinitions(){
  const make=(scope,definitions)=>definitions.map(([key,label,values])=>({key:scope+'.'+key,label,scope,field:key,values}));
  return [
    {key:'record.buildingType',label:'Sorted category number',scope:'record',field:'buildingType',values:buildingTypeGroups().map(([n])=>String(n))},
    {key:'record.status',label:'Tagging status',scope:'record',field:'status',values:['Not started','In progress','Completed']},
    {key:'record.location',label:'Location coordinates',scope:'record',field:'location',values:['Has coordinates','No coordinates']},
    ...make('context',contextFields),
    {key:'division.homogeneity',label:'Façade composition',scope:'division',field:'homogeneity',values:['Homogeneous','Heterogeneous']},
    ...make('type',typeFields.filter(d=>d[0]!=='threshold')),
    {key:'type.depth',label:'Threshold depth',scope:'type',field:'depth',values:['Under 1 m','1 m or more','Not applicable','Unknown']},
    {key:'type.enclosure',label:'Threshold enclosure',scope:'type',field:'enclosure',values:['Low','Medium','High','Unknown']},
    ...make('type',extraFields)
  ];
}
function restoreAnalysisFilters(value){
  if(!value||typeof value!=='object')return;
  analysisFilters.graphs=restoreRelationshipGraphs(value.graphs);
  analysisFilters.search=typeof value.search==='string'?value.search:'';
  if(['gallery','map','both'].includes(value.mode))analysisFilters.mode=value.mode;
  analysisFilters.rules=Array.isArray(value.rules)?value.rules.filter(r=>r&&typeof r.key==='string'&&typeof r.value==='string').map(r=>({key:r.key,value:r.value})):[];
}
function attributeFilterValue(photo,record,type,definition){
  if(definition.scope==='record'){
    if(definition.field==='status')return record.completed?'Completed':record.updatedAt?'In progress':'Not started';
    if(definition.field==='location')return validPosition(locationFor(photo))?'Has coordinates':'No coordinates';
    return record[definition.field]==null?undefined:String(record[definition.field]);
  }
  if(definition.scope==='type'&&['depth','enclosure'].includes(definition.field)&&thresholdValue(type)!=='Yes')return undefined;
  return (definition.scope==='type'?type:record[definition.scope]||{})[definition.field];
}
function filterPhotoMatches(photo){
  if(analysisFilters.search&&!photo.name.toLowerCase().includes(analysisFilters.search.toLowerCase().trim()))return false;
  const definitions=filterDefinitions(),groups=new Map();
  for(const rule of analysisFilters.rules){if(!rule.value||!definitions.some(d=>d.key===rule.key))continue;if(!groups.has(rule.key))groups.set(rule.key,[]);groups.get(rule.key).push(rule.value);}
  const record=records[photo.id]||{},typeGroups=[];
  const matches=(definition,values,type)=>{
    const actual=attributeFilterValue(photo,record,type||{},definition);
    return values.some(value=>value==='__missing__'?actual==null||actual===''||Array.isArray(actual)&&!actual.length:Array.isArray(actual)?actual.includes(value):String(actual)===value);
  };
  for(const [key,values]of groups){const definition=definitions.find(d=>d.key===key);if(definition.scope==='type')typeGroups.push([definition,values]);else if(!matches(definition,values))return false;}
  return !typeGroups.length||(record.types?.length?record.types:[{}]).some(type=>typeGroups.every(([definition,values])=>matches(definition,values,type)));
}
function filterRuleMarkup(rule,index){
  const definitions=filterDefinitions(),definition=definitions.find(d=>d.key===rule.key)||definitions.find(d=>d.key==='type.kind');
  return `<div class="analysis-filter-row"><label>Attribute<select data-filter-key="${index}">${definitions.map(d=>`<option value="${esc(d.key)}" ${d.key===definition.key?'selected':''}>${esc(d.label)}</option>`).join('')}</select></label><label>Value<select data-filter-value="${index}"><option value="">Any value</option>${definition.values.map(v=>`<option value="${esc(v)}" ${v===rule.value?'selected':''}>${esc(v)}</option>`).join('')}<option value="__missing__" ${rule.value==='__missing__'?'selected':''}>Not answered / not applicable</option></select></label><button data-remove-filter="${index}" aria-label="Remove filter ${index+1}">×</button></div>`;
}
function renderFilterAnalysis(){
  document.getElementById('main').innerHTML=`<div class="intro"><div><div class="eyebrow">Collection analysis</div><h1>Explore the façades.</h1><p class="muted">One set of filters. Browse the matching photographs and locations.</p></div><button id="returnEntry">← Back to tagging</button></div><div class="filtered-analysis-layout"><section class="insight-card analysis-filter-panel"><h2>Attribute filters</h2><p class="hint">Different attributes narrow the results. Repeated choices for one attribute are alternatives. Type-specific attributes must match the same façade type.</p><label class="filter-search-label">Photo name<input id="analysisPhotoSearch" value="${esc(analysisFilters.search)}" placeholder="Find a photo…"></label><div id="analysisFilterRows">${analysisFilters.rules.map(filterRuleMarkup).join('')}</div><div class="filter-actions"><button id="addAnalysisFilter">+ Add filter</button><button id="clearAnalysisFilters">Clear all</button></div><p id="analysisMatchCount" class="hint" role="status"></p></section><div class="analysis-content"><nav class="analysis-view-switch" aria-label="Analysis view">${['gallery','map','both'].map(mode=>`<button data-analysis-view="${mode}" aria-pressed="${analysisFilters.mode===mode}">${mode[0].toUpperCase()+mode.slice(1)}</button>`).join('')}</nav><div class="comparison-toolbar"><button id="addRelationshipGraph">+ Add graph</button></div><div id="relationshipGraphs"></div><section id="analysisMapSection" class="insight-card analysis-map-panel"><h2>Geographic overview</h2><p class="hint">Only matching photos appear here. Zoom and pan, then select a marker to open a photo.</p><div id="mapPlot"></div></section><section id="analysisGallerySection" class="insight-card analysis-gallery-panel"><h2>Photo library</h2><p class="hint">Select a photo to preview its tags or continue editing. Photos without coordinates are included.</p><div id="filteredPhotoResults" class="facade-gallery"></div></section></div></div>`;
  updateFilteredAnalysis();
}
function updateFilteredAnalysis(){
  if(view!=='insights'||!document.getElementById('filteredPhotoResults'))return;
  filteredAnalysisPhotos=photos.filter(filterPhotoMatches);
  const located=filteredAnalysisPhotos.filter(p=>validPosition(locationFor(p))).length;
  document.getElementById('analysisMatchCount').textContent=`${filteredAnalysisPhotos.length} of ${photos.length} photos match · ${located} on map · ${filteredAnalysisPhotos.length-located} without coordinates`;
  document.getElementById('filteredPhotoResults').innerHTML=filteredAnalysisPhotos.map(p=>{const r=records[p.id]||{},kinds=[...new Set((r.types||[]).map(t=>t.kind).filter(Boolean))];return `<button class="facade-gallery-card" data-gallery-photo="${esc(p.id)}" aria-label="Preview ${esc(p.name)}"><img src="${esc(p.src)}" alt="${esc(p.name)}" loading="lazy"><span class="gallery-card-info"><strong>${esc(p.name)}</strong><span>${r.buildingType?'Category '+r.buildingType:'Unsorted'} · ${r.completed?'Completed':r.updatedAt?'In progress':'Not started'}</span><span>${esc(kinds.join(' · ')||'No façade tags yet')}</span>${validPosition(locationFor(p))?'':'<span class="gallery-no-location">No coordinates</span>'}</span></button>`;}).join('')||'<p class="empty">No photos match these filters.</p>';
  applyAnalysisView();renderComparisonGraphs();
}
function applyAnalysisView(){
  const mode=analysisFilters.mode||'both';
  document.getElementById('analysisMapSection').hidden=mode==='gallery';
  document.getElementById('analysisGallerySection').hidden=mode==='map';
  document.querySelectorAll('[data-analysis-view]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.analysisView===mode)));
  disposeOverviewMap();
  if(mode!=='gallery')renderMap(filteredAnalysisPhotos);
  else{overviewPoints=filteredAnalysisPhotos.filter(p=>validPosition(locationFor(p)));document.getElementById('mapPlot').innerHTML='';}
}
function openGalleryPreview(id){
  const photo=filteredAnalysisPhotos.find(p=>p.id===id);if(!photo)return;
  galleryPreviewId=id;
  let dialog=document.getElementById('galleryPreview');if(!dialog){dialog=document.createElement('dialog');dialog.id='galleryPreview';dialog.className='gallery-preview-dialog';document.body.append(dialog);}
  const record=records[id]||blank(),index=filteredAnalysisPhotos.indexOf(photo);
  dialog.innerHTML=`<div class="gallery-preview-header"><div><h2>${esc(photo.name)}</h2><span class="hint">${index+1} / ${filteredAnalysisPhotos.length} matching photos${record.buildingType?' · Category '+record.buildingType:''}</span></div><button data-preview-close aria-label="Close preview">×</button></div><div class="gallery-preview-layout"><img class="gallery-preview-image" src="${esc(photo.src)}" alt="${esc(photo.name)}"><div class="gallery-preview-tags"><h3>Urban context</h3>${summaryRows(record.context||{},contextFields)}<h3>Façade composition</h3><p>${esc(record.division?.homogeneity||'Not answered')}</p>${(record.types||[]).map((type,i)=>`<h3>Type ${i+1}</h3>${summaryRows(type,[...questionsForType(type),...(thresholdValue(type)==='Yes'?[['depth','Threshold depth'],['enclosure','Threshold enclosure']]:[]),...extraFields])}`).join('')}${record.notes?`<h3>Notes</h3><p>${esc(record.notes)}</p>`:''}</div></div><div class="gallery-preview-footer"><div><button data-preview-direction="-1" ${index===0?'disabled':''}>← Previous</button> <button data-preview-direction="1" ${index===filteredAnalysisPhotos.length-1?'disabled':''}>Next →</button></div><button class="primary" data-preview-edit="${esc(id)}">Edit tags</button></div>`;
  if(!dialog.open)dialog.showModal();
}
function saveAnalysisFilterChange(){persist();updateFilteredAnalysis();}
document.addEventListener('change',event=>{
  const element=event.target;
  if(element.dataset.filterKey!==undefined){const index=+element.dataset.filterKey;analysisFilters.rules[index]={key:element.value,value:''};document.getElementById('analysisFilterRows').innerHTML=analysisFilters.rules.map(filterRuleMarkup).join('');saveAnalysisFilterChange();}
  if(element.dataset.filterValue!==undefined){analysisFilters.rules[+element.dataset.filterValue].value=element.value;saveAnalysisFilterChange();}
});
document.addEventListener('input',event=>{if(event.target.id==='analysisPhotoSearch'){analysisFilters.search=event.target.value;clearTimeout(filterSearchTimer);filterSearchTimer=setTimeout(saveAnalysisFilterChange,250);}});
document.addEventListener('click',event=>{
  const button=event.target.closest('button');if(!button)return;
  if(button.id==='addAnalysisFilter'){analysisFilters.rules.push({key:'type.kind',value:''});document.getElementById('analysisFilterRows').innerHTML=analysisFilters.rules.map(filterRuleMarkup).join('');persist();}
  if(button.dataset.removeFilter!==undefined){analysisFilters.rules.splice(+button.dataset.removeFilter,1);document.getElementById('analysisFilterRows').innerHTML=analysisFilters.rules.map(filterRuleMarkup).join('');saveAnalysisFilterChange();}
  if(button.id==='clearAnalysisFilters'){analysisFilters={search:'',rules:[],mode:analysisFilters.mode||'both',graphs:analysisFilters.graphs||[]};renderFilterAnalysis();persist();}
  if(button.dataset.analysisView){analysisFilters.mode=button.dataset.analysisView;applyAnalysisView();persist();}
  if(button.dataset.galleryPhoto)openGalleryPreview(button.dataset.galleryPhoto);
  if(button.hasAttribute('data-preview-close'))document.getElementById('galleryPreview').close();
  if(button.dataset.previewDirection){const index=filteredAnalysisPhotos.findIndex(p=>p.id===galleryPreviewId),photo=filteredAnalysisPhotos[index+Number(button.dataset.previewDirection)];if(photo)openGalleryPreview(photo.id);}
  if(button.dataset.previewEdit){document.getElementById('galleryPreview').close();current=button.dataset.previewEdit;step=0;typeIndex=0;view='entry';render();}
});
document.addEventListener('keydown',event=>{if(!document.getElementById('galleryPreview')?.open||!['ArrowLeft','ArrowRight'].includes(event.key)||/INPUT|TEXTAREA|SELECT/.test(event.target.tagName))return;event.preventDefault();const index=filteredAnalysisPhotos.findIndex(p=>p.id===galleryPreviewId),photo=filteredAnalysisPhotos[index+(event.key==='ArrowRight'?1:-1)];if(photo)openGalleryPreview(photo.id);});

</script>
<script>
/* Multiple independent attribute comparisons, using the same filtered collection. */
let relationshipGraphGroups=new Map();
function restoreRelationshipGraphs(value){
  if(!Array.isArray(value))return [];
  const seen=new Set();return value.filter(g=>g&&typeof g.id==='string'&&!seen.has(g.id)&&seen.add(g.id)&&typeof g.x==='string'&&typeof g.y==='string').map(g=>({id:g.id,x:g.x,y:g.y,type:['scatter','bar','pie'].includes(g.type)?g.type:'scatter',attribute:typeof g.attribute==='string'?g.attribute:g.x}));
}
function graphDefinitions(){return filterDefinitions();}
function graphProfileMatches(photo,type){
  const defs=filterDefinitions(),rules=new Map(),record=records[photo.id]||{};
  for(const rule of analysisFilters.rules){if(!rule.value||!rule.key.startsWith('type.'))continue;if(!rules.has(rule.key))rules.set(rule.key,[]);rules.get(rule.key).push(rule.value);}
  for(const [key,values]of rules){const def=defs.find(d=>d.key===key);if(!def)continue;const actual=attributeFilterValue(photo,record,type,def);if(!values.some(v=>v==='__missing__'?actual==null||actual===''||Array.isArray(actual)&&!actual.length:Array.isArray(actual)?actual.includes(v):String(actual)===v))return false;}
  return true;
}
function graphValues(profile,definition){
  const raw=attributeFilterValue(profile.photo,profile.record,profile.type,definition);
  return (Array.isArray(raw)?raw:[raw]).filter(v=>v!=null&&v!==''&&!['Unknown','Not applicable'].includes(v)).flatMap(v=>{
    if(['type.windows','type.share'].includes(definition.key)){const number={'0':0,'¼':.25,'⅓':1/3,'½':.5,'⅔':2/3,'¾':.75,'1':1}[v];return number===undefined?[]:[{value:number,label:String(v)}];}
    const index=definition.values.indexOf(String(v));return index<0?[]:[{value:index,label:String(v)}];
  });
}
function relationshipGraphSvg(graph,definitions){
  const x=definitions.find(d=>d.key===graph.x),y=definitions.find(d=>d.key===graph.y);
  if(!x||!y)return {html:'<p class="empty">Select an attribute for each axis.</p>',groups:[],description:''};
  const profiles=filteredAnalysisPhotos.flatMap(photo=>(records[photo.id]?.types?.length?records[photo.id].types:[{}]).flatMap((type,index)=>graphProfileMatches(photo,type)?[{photo,type,index,record:records[photo.id]||{}}]:[]));
  const points=[],used=new Set();profiles.forEach(p=>{for(const a of graphValues(p,x))for(const b of graphValues(p,y)){points.push({profile:p,x:a,y:b});used.add(p.photo.id+'|'+p.index);}});
  const buckets=new Map();for(const point of points){const key=point.x.value+'|'+point.y.value;if(!buckets.has(key))buckets.set(key,[]);buckets.get(key).push(point);}const groups=[...buckets.values()];
  const quantitative=d=>['type.windows','type.share'].includes(d.key);
  const ticks=d=>quantitative(d)?[{value:0,label:'0'},{value:.25,label:'¼'},{value:1/3,label:'⅓'},{value:.5,label:'½'},{value:2/3,label:'⅔'},{value:.75,label:'¾'},{value:1,label:'1'}]:d.values.map((label,value)=>({label,value})).filter(t=>!['Unknown','Not applicable'].includes(t.label));
  const scale=(d,v,length)=>quantitative(d)?v*length:(v+.5)/Math.max(1,d.values.length)*length;
  const w=820,h=530,left=190,top=35,pw=585,ph=330;
  let svg=`<svg viewBox="0 0 ${w} ${h}" role="img" aria-label="${esc(x.label)} versus ${esc(y.label)}"><rect x="${left}" y="${top}" width="${pw}" height="${ph}" fill="white" stroke="#00000066"/>`;
  ticks(x).forEach(t=>{const px=left+scale(x,t.value,pw);svg+=`<line x1="${px}" y1="${top}" x2="${px}" y2="${top+ph}" stroke="#00000018"/><text x="${px}" y="${top+ph+18}" transform="rotate(35 ${px} ${top+ph+18})" font-size="10">${esc(t.label)}</text>`;});
  ticks(y).forEach(t=>{const py=top+ph-scale(y,t.value,ph);svg+=`<line x1="${left}" y1="${py}" x2="${left+pw}" y2="${py}" stroke="#00000018"/><text x="${left-9}" y="${py+3}" text-anchor="end" font-size="10">${esc(t.label)}</text>`;});
  svg+=`<text x="${left+pw/2}" y="${h-12}" text-anchor="middle" font-size="12">${esc(x.label)}</text><text transform="translate(14 ${top+ph/2}) rotate(-90)" text-anchor="middle" font-size="12">${esc(y.label)}</text>`;
  groups.forEach((group,index)=>{const px=left+scale(x,group[0].x.value,pw),py=top+ph-scale(y,group[0].y.value,ph),r=Math.min(23,7+Math.sqrt(group.length-1)*3);svg+=`<a href="#" data-comparison-point="${esc(graph.id)}" data-point-index="${index}" aria-label="${esc(group[0].x.label+' / '+group[0].y.label+' · '+group.length+' observations')}"><circle cx="${px}" cy="${py}" r="${r}" fill="#002FA7" fill-opacity=".8" stroke="white" stroke-width="2"><title>${esc(group[0].x.label+' / '+group[0].y.label+' · '+group.length+' observations')}</title></circle>${group.length>1?`<text x="${px}" y="${py+4}" text-anchor="middle" font-size="11" fill="white">${group.length}</text>`:''}</a>`;});
  return {html:svg+'</svg>'+(points.length?'':'<p class="empty">No matching observations have answers for both attributes.</p>'),groups,description:`${used.size} of ${profiles.length} façade observations plotted · ${profiles.length-used.size} missing or not applicable · ${points.length} points before grouping.`};
}
function renderComparisonGraphs(){
  const host=document.getElementById('relationshipGraphs');if(!host)return;
  relationshipGraphGroups.clear();
  const definitions=graphDefinitions();
  host.innerHTML=(analysisFilters.graphs||[]).map((graph,index)=>{
    const isDistribution=['bar','pie'].includes(graph.type),result=isDistribution?distributionGraphSvg(graph,definitions):relationshipGraphSvg(graph,definitions);relationshipGraphGroups.set(graph.id,result.groups);
    const selector=(axis)=>`<label>${axis.toUpperCase()} axis<select data-comparison-axis="${axis}" data-comparison-id="${esc(graph.id)}">${definitions.map(d=>`<option value="${esc(d.key)}" ${graph[axis]===d.key?'selected':''}>${esc(d.label)}</option>`).join('')}</select></label>`;
    const chartType=`<label>Chart type<select data-graph-type="${esc(graph.id)}">${[['scatter','X/Y comparison'],['bar','Bar chart'],['pie','Pie chart']].map(([value,label])=>`<option value="${value}" ${(graph.type||'scatter')===value?'selected':''}>${label}</option>`).join('')}</select></label>`;
    const attribute=`<label>Attribute<select data-distribution-attribute="${esc(graph.id)}">${definitions.map(d=>`<option value="${esc(d.key)}" ${(graph.attribute||graph.x)===d.key?'selected':''}>${esc(d.label)}</option>`).join('')}</select></label>`;
    return `<section class="insight-card comparison-graph" data-graph-card="${esc(graph.id)}"><div class="comparison-heading"><h2>${isDistribution?(graph.type==='pie'?'Pie chart':'Bar chart'):'Attribute comparison'} ${index+1}</h2><button data-remove-comparison="${esc(graph.id)}">Remove graph</button></div><div class="comparison-selectors">${chartType}${isDistribution?attribute:selector('x')+selector('y')}</div>${isDistribution?'':'<p class="hint">Each façade type is an observation. Photo-level attributes repeat across its types. Multiple selections can produce multiple points. Bubble numbers show overlapping observations.</p>'}<div class="comparison-svg">${result.html}</div><p class="hint" role="status">${esc(result.description)}</p><div data-comparison-details="${esc(graph.id)}"></div></section>`;
  }).join('');
}
document.addEventListener('click',event=>{
  const button=event.target.closest('button');
  if(button?.id==='addRelationshipGraph'){
    if(!analysisFilters.graphs)analysisFilters.graphs=[];
    analysisFilters.graphs.push({id:crypto.randomUUID(),type:'scatter',attribute:'type.kind',x:'type.windows',y:'type.enclosure'});renderComparisonGraphs();persist();
  }
  if(button?.dataset.removeComparison){analysisFilters.graphs=(analysisFilters.graphs||[]).filter(g=>g.id!==button.dataset.removeComparison);renderComparisonGraphs();persist();}
  const point=event.target.closest('[data-comparison-point]');
  if(point){event.preventDefault();const group=relationshipGraphGroups.get(point.dataset.comparisonPoint)?.[+point.dataset.pointIndex]||[],host=[...document.querySelectorAll('[data-comparison-details]')].find(e=>e.dataset.comparisonDetails===point.dataset.comparisonPoint);if(host)host.innerHTML=group.map(p=>`<button data-comparison-photo="${esc(p.profile.photo.id)}" class="comparison-photo-link">${esc(p.profile.photo.name)}${p.profile.index>=0?' · Type '+(p.profile.index+1):''}</button>`).join('');}
  if(button?.dataset.comparisonPhoto)openGalleryPreview(button.dataset.comparisonPhoto);
});
document.addEventListener('change',event=>{
  const element=event.target;
  if(element.dataset.graphType||element.dataset.distributionAttribute){const id=element.dataset.graphType||element.dataset.distributionAttribute,graph=analysisFilters.graphs?.find(g=>g.id===id);if(graph){if(element.dataset.graphType)graph.type=element.value;else graph.attribute=element.value;renderComparisonGraphs();persist();}return;}
  if(!element.dataset.comparisonAxis)return;
  const graph=analysisFilters.graphs?.find(g=>g.id===element.dataset.comparisonId);if(!graph)return;
  graph[element.dataset.comparisonAxis]=element.value;renderComparisonGraphs();persist();
});

function distributionGraphData(graph,definitions){
  const definition=definitions.find(d=>d.key===(graph.attribute||graph.x));
  if(!definition)return {definition:null,buckets:[],observations:0,answered:0,total:0,multi:false};
  const profiles=filteredAnalysisPhotos.flatMap(photo=>{
    const record=records[photo.id]||{};
    return definition.scope==='type'?(record.types?.length?record.types:[{}]).flatMap((type,index)=>graphProfileMatches(photo,type)?[{photo,record,type,index}]:[]):[{photo,record,type:{},index:-1}];
  });
  const buckets=new Map();let answered=0,multi=false;
  for(const profile of profiles){const raw=attributeFilterValue(profile.photo,profile.record,profile.type,definition),values=[...new Set((Array.isArray(raw)?raw:[raw]).filter(v=>v!=null&&v!=='').map(String))];
    if(!values.length)continue;answered++;if(values.length>1)multi=true;
    for(const value of values){if(!buckets.has(value))buckets.set(value,[]);buckets.get(value).push({profile});}
  }
  const ordered=[...definition.values,...buckets.keys()].filter((v,i,array)=>array.indexOf(v)===i&&buckets.has(v));
  return {definition,buckets:ordered.map(label=>({label,items:buckets.get(label)})),observations:profiles.length,answered,total:[...buckets.values()].reduce((n,items)=>n+items.length,0),multi};
}
function distributionGraphSvg(graph,definitions){
  const data=distributionGraphData(graph,definitions),groups=data.buckets.map(b=>b.items);
  if(!data.total)return {html:'<p class="empty">No matching observations have an answer for this attribute.</p>',groups,description:`${data.observations} observations · no answers.`};
  const unit=data.definition.scope==='type'?'façade types':'photos';
  const description=`${data.answered} of ${data.observations} ${unit} answered · ${data.observations-data.answered} missing. ${data.multi?'Multiple selections: counts and pie percentages represent selections, not unique '+unit+'.':'One count per '+(unit==='photos'?'photo':'façade type')+'.'} Explicit Unknown / Not applicable answers are included.`;
  const link=(index,content)=>`<a href="#" data-comparison-point="${esc(graph.id)}" data-point-index="${index}" aria-label="${esc(data.buckets[index].label+' · '+data.buckets[index].items.length)}">${content}</a>`;
  if(graph.type==='bar'){
    const row=38,height=80+row*data.buckets.length,max=Math.max(...data.buckets.map(b=>b.items.length));let svg=`<svg viewBox="0 0 820 ${height}" role="img" aria-label="Bar chart of ${esc(data.definition.label)}">`;
    data.buckets.forEach((b,i)=>{const y=25+i*row,width=480*b.items.length/max;svg+=link(i,`<text x="230" y="${y+18}" text-anchor="end" font-size="12">${esc(b.label)}</text><rect x="245" y="${y}" width="${width}" height="26" fill="#002FA7"><title>${esc(b.label)}: ${b.items.length}</title></rect><text x="${255+width}" y="${y+18}" font-size="12">${b.items.length}</text>`);});
    svg+=`<line x1="245" y1="15" x2="245" y2="${height-45}" stroke="black"/><text x="485" y="${height-10}" text-anchor="middle" font-size="12">Count of ${unit}${data.multi?' selections':''}</text></svg>`;
    return {html:svg,groups,description};
  }
  let svg='<svg viewBox="0 0 440 340" role="img" aria-label="Pie chart">',angle=-Math.PI/2;
  const colors=['#002FA7','#000000','#002FA7','#000000','#002FA7','#000000'];
  data.buckets.forEach((b,i)=>{const portion=b.items.length/data.total,end=angle+portion*2*Math.PI,color=colors[i%colors.length],opacity=[1,1,.65,.65,.35,.35][i%6],title=`${b.label}: ${b.items.length} (${(portion*100).toFixed(1)}%)`;
    const shape=portion===1?`<circle cx="220" cy="170" r="140" fill="${color}" fill-opacity="${opacity}"><title>${esc(title)}</title></circle>`:`<path d="M 220 170 L ${220+140*Math.cos(angle)} ${170+140*Math.sin(angle)} A 140 140 0 ${portion>.5?1:0} 1 ${220+140*Math.cos(end)} ${170+140*Math.sin(end)} Z" fill="${color}" fill-opacity="${opacity}" stroke="white" stroke-width="2"><title>${esc(title)}</title></path>`;
    svg+=link(i,shape);angle=end;
  });
  const legend=data.buckets.map((b,i)=>`<button class="distribution-legend-item" data-comparison-point="${esc(graph.id)}" data-point-index="${i}"><span style="background:${colors[i%6]};opacity:${[1,1,.65,.65,.35,.35][i%6]}"></span><b>${esc(b.label)}</b><span>${b.items.length} · ${(100*b.items.length/data.total).toFixed(1)}%</span></button>`).join('');
  return {html:`<div class="distribution-pie">${svg}</svg><div class="distribution-legend">${legend}</div></div>`,groups,description};
}

</script>

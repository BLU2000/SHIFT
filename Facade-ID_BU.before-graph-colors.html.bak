<body>
<header><div class="logo">Facade ID<span class="logo-period">.</span></div><span class="header-caption">Façade classification</span><div class="toolbar"><span id="revisionLabel" class="revision-label">v010 · BU</span><span class="save-state" id="saveState" role="status">✓ Saved in this browser</span><button class="primary" id="saveHtml">Save</button></div></header>
<div class="shell"><aside><div class="collection-meta"><h2>Your collection</h2><span id="total" class="eyebrow">202 photos</span></div><input id="search" aria-label="Find a photograph" placeholder="Find a photograph…"><select id="statusFilter" aria-label="Filter by completion"><option value="all">All photographs</option><option value="todo">To classify</option><option value="done">Completed</option></select><button id="sortPhotos" class="full" style="margin:6px 0 8px">Sort into categories</button><button id="addPhotos" class="full" style="margin:6px 0 12px">+ Add photos</button><p id="uploadStatus" class="hint" role="status"></p><div class="photo-list" id="photoList"></div><div class="hint" style="margin-top:18px">Changes save in this browser.<br>Use Save to download your updated copy.</div><button id="mergeButton" class="merge-link">Merge files</button><button id="undoPhotoDelete" class="merge-link" hidden="">Undo last deletion</button></aside><main id="main"></main></div>
<input id="photoFiles" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif,.heic,.heif" multiple="" hidden="">
<input id="mergeFile" type="file" accept=".html,.json" multiple="" hidden=""><dialog id="mergeDialog"></dialog>
<dialog id="saveDialog" class="save-dialog"><form id="saveForm"><div class="eyebrow">Save a copy</div><h2>Your initials. Your version.</h2><p class="hint">The HTML includes all photographs, your answers, and the save version.</p><label for="saveInitials">Your initials</label><input id="saveInitials" name="initials" placeholder="e.g. BU" autocomplete="off" maxlength="12" pattern="[A-Za-z0-9]{1,12}" required=""><p class="hint">For example, BU for Balthasar Unger.</p><div class="filename-preview"><span class="eyebrow">File name</span><output id="saveFilenamePreview">Facade-ID_BU_v010.html</output></div><div class="form-footer"><button type="button" id="cancelSave">Cancel</button><button type="submit" class="primary">Download HTML</button></div></form></dialog>
